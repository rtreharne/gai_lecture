---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const nav = [
  ['About', '#about'],
  ['Skills', '#skills'],
  ['Experience', '#experience'],
  ['Education', '#education'],
  ['Contact', '#contact']
];
---

<Layout>
  <header class="site-header" data-header>
    <a class="wordmark" href="#top" aria-label="Susan Calvin home">
      <span class="wordmark-mark">SC</span>
      <span>Susan Calvin</span>
    </a>
    <span class="design-label" aria-label="Design B: scientific editorial">Design B / 2026</span>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Toggle navigation</span>
      <span aria-hidden="true">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="nav-cv" href={`${base}documents/susan-calvin-cv.pdf`} target="_blank" rel="noreferrer">View CV <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="hero-graphic" aria-hidden="true">
        <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span>
        <span class="signal signal-one"></span><span class="signal signal-two"></span><span class="signal signal-three"></span>
        <span class="axis-label axis-x">evidence</span><span class="axis-label axis-y">curiosity</span>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">BSc Biosciences student · University of Liverpool</p>
        <h1 id="hero-title">Careful science.<br /><em>Curious thinking.</em></h1>
        <p class="hero-intro">I am Susan, a first-year Biosciences student building practical laboratory, quantitative and scientific communication skills for a career in life sciences.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact">Get in touch <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href={`${base}documents/susan-calvin-cv.pdf`} target="_blank" rel="noreferrer">Download CV <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="hero-facts" aria-label="Key profile facts">
          <div><dt>Based in</dt><dd>Warrington, Cheshire</dd></div>
          <div><dt>Focus</dt><dd>Laboratory · Data · Quality</dd></div>
        </dl>
      </div>
      <div class="hero-index" aria-label="Profile overview">
        <div><span>01</span><strong>BSc Biosciences</strong><p>University of Liverpool</p></div>
        <div><span>02</span><strong>Laboratory · data · quality</strong><p>Early-career focus</p></div>
        <div><span>03</span><strong>Warrington, Cheshire</strong><p>Open to opportunities</p></div>
      </div>
    </section>

    <section id="about" class="section section-about" aria-labelledby="about-title">
      <div class="section-kicker">01 / About</div>
      <div class="section-content split-layout">
        <div>
          <h2 id="about-title">Learning to make a difference through careful work.</h2>
        </div>
        <div class="prose">
          <p>I am a reliable first-year BSc Biosciences student motivated to turn biology knowledge into practical contribution. I enjoy work that demands care, consistency and curiosity—from keeping clear records in the lab to helping a team deliver a great experience in a busy cinema.</p>
          <p>I am especially interested in how quality systems, laboratory practice and scientific evidence combine to help deliver safe, effective medicines.</p>
        </div>
      </div>
    </section>

    <section id="skills" class="section section-tint" aria-labelledby="skills-title">
      <div class="section-kicker">02 / Skills</div>
      <div class="section-content">
        <h2 id="skills-title">A foundation for practical bioscience.</h2>
        <div class="skill-grid">
          <article class="skill-card">
            <span class="skill-number">01 / LAB</span>
            <h3>Laboratory practice</h3>
            <p>Basic laboratory equipment, following written procedures, accurate record keeping, hygiene, safe working and attention to detail.</p>
          </article>
          <article class="skill-card">
            <span class="skill-number">02 / DATA</span>
            <h3>R & data analysis</h3>
            <p>Cleaning data, running statistical analyses, creating visualisations, interpreting results and communicating findings clearly.</p>
          </article>
          <article class="skill-card">
            <span class="skill-number">03 / AI</span>
            <h3>Responsible AI</h3>
            <p>Using generative AI for planning, revision and feedback while verifying claims, protecting information and following assessment guidance.</p>
          </article>
          <article class="skill-card">
            <span class="skill-number">04 / TEAM</span>
            <h3>Clear communication</h3>
            <p>Explaining information accurately, listening to others, working collaboratively and asking for guidance when it helps the team.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="experience" class="section" aria-labelledby="experience-title">
      <div class="section-kicker">03 / Experience</div>
      <div class="section-content">
        <h2 id="experience-title">Reliable in the lab, capable in a team.</h2>
        <div class="timeline">
          <article class="timeline-entry">
            <div class="timeline-meta"><span>July 2025</span><span>Cheshire</span></div>
            <div>
              <h3>Work Experience Placement</h3>
              <p class="timeline-org">Willowbank Animal Rescue Centre</p>
              <p>Followed staff instructions and hygiene procedures; prepared food and organised supplies; observed routine animal care and the importance of consistent procedures, welfare and accuracy.</p>
            </div>
          </article>
          <article class="timeline-entry">
            <div class="timeline-meta"><span>Jan 2026 — present</span><span>Warrington</span></div>
            <div>
              <h3>Usher (part-time)</h3>
              <p class="timeline-org">Westbrook Cinema</p>
              <p>Support customers, prepare screens to a consistent standard, resolve seating issues and report problems promptly to the duty manager.</p>
            </div>
          </article>
          <article class="timeline-entry">
            <div class="timeline-meta"><span>Mar — May 2025</span><span>Volunteer</span></div>
            <div>
              <h3>Habitat maintenance</h3>
              <p class="timeline-org">Friends of Sankey Valley Park</p>
              <p>Contributed to weekend litter-picking and habitat-maintenance sessions, helping to collect litter and clear pathways with other volunteers.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="education" class="section section-dark" aria-labelledby="education-title">
      <div class="section-kicker">04 / Education & coursework</div>
      <div class="section-content split-layout">
        <div>
          <h2 id="education-title">Building practical and quantitative confidence.</h2>
          <a class="text-link" href={`${base}documents/susan-calvin-cv.pdf`} target="_blank" rel="noreferrer">Read the tailored AstraZeneca CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="education-list">
          <article>
            <p class="date">Sep 2026 — present</p>
            <h3>BSc Biosciences</h3>
            <p>University of Liverpool · First year</p>
            <ul>
              <li>Practical Laboratory and Quantitative Skills</li>
              <li>Core Concepts in Biology</li>
              <li>Study and Communication Skills</li>
            </ul>
          </article>
          <article>
            <p class="date">2024 — 2026</p>
            <h3>A levels</h3>
            <p>Oakfield Sixth Form College · Biology (B), Geography (B), Chemistry (C)</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-project" aria-labelledby="project-title">
      <div class="section-kicker">05 / How I work</div>
      <div class="section-content project-layout">
        <div class="project-statement">
          <p class="eyebrow">Evidence before assumption</p>
          <h2 id="project-title">Data, AI and good judgement work together.</h2>
          <div class="data-signal" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="prose">
          <p>In my quantitative-skills coursework, I use R to clean data, run statistical analyses, create visualisations and explain what the results mean. I approach generative AI in the same way: it can be useful for planning and learning, but its outputs must be checked against reliable sources and my own understanding.</p>
          <p>This combination of practical work, careful data handling and critical thinking is the foundation I want to bring to a laboratory or quality-focused team.</p>
        </div>
      </div>
    </section>

    <section id="contact" class="section contact-section" aria-labelledby="contact-title">
      <div class="section-kicker">06 / Contact</div>
      <div class="section-content contact-layout">
        <div>
          <h2 id="contact-title">Let’s start a conversation.</h2>
          <p class="contact-intro">Interested in a placement, laboratory experience or a bioscience opportunity? I would be pleased to hear from you.</p>
          <a class="contact-email" href="mailto:susan.calvin@example.com">susan.calvin@example.com <span aria-hidden="true">↗</span></a>
          <p class="contact-phone">07700 900284</p>
        </div>
        <form class="contact-form" data-contact-form novalidate>
          <div class="form-row">
            <label for="name">Name</label>
            <input id="name" name="name" autocomplete="name" required />
          </div>
          <div class="form-row">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button class="button button-primary" type="submit">Send message <span aria-hidden="true">→</span></button>
          <p class="form-note">Demo form only: no data is sent or stored.</p>
          <p class="form-status" data-form-status aria-live="polite" hidden></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>© 2026 Susan Calvin · Biosciences student</p>
  </footer>

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.site-nav');
    const links = nav?.querySelectorAll('a');
    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      nav?.classList.toggle('is-open', !isOpen);
    });
    links?.forEach((link) => link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('is-open');
    }));

    const form = document.querySelector('[data-contact-form]');
    const status = document.querySelector('[data-form-status]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.reset();
      if (status) {
        status.hidden = false;
        status.textContent = 'Thanks — this demo form has been completed. No message was sent or stored.';
      }
    });
  </script>
</Layout>
